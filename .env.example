# ============================================================================
# Merge — environment. Copy to .env.local and fill what you have.
# The app runs fully WITHOUT any of these (mock mode). Each key you add turns
# on a real side effect for that adapter.
# ============================================================================

# --- Changeset generation (falls back to 3 hardcoded scenarios if absent) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8

# --- Real email on Merge (Resend). Sandbox sends FROM onboarding@resend.dev ---
# --- and only TO your signup address until you verify a domain. ---
RESEND_API_KEY=
DEMO_EMAIL_TO=hyperr.ware@gmail.com

# --- Real Linear issue on Merge (revert = archive) ---
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# --- Real Slack message on Merge (revert = delete). Invite the bot to the channel. ---
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# SLACK_WEBHOOK_URL=   # optional fallback (cannot be reverted)

# --- Stretch integrations ---
CHANNEL3_API_KEY=
CRUSTDATA_TOKEN=

# --- Hexclave / Stack Auth (auth + RBAC + Data Vault). Names depend on the
#     package chosen (@stackframe/stack uses NEXT_PUBLIC_STACK_* / STACK_*). ---
NEXT_PUBLIC_STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=
STACK_SECRET_SERVER_KEY=
STACK_DATA_VAULT_SECRET=
